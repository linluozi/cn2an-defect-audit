+    def __round_rmb(self, integer_data: str, decimal_data: str) -> tuple:
+        """取角分，截断放在取位之后。
+
+        上游先用 __decimal_convert(fraction, "up") 把小数逐位转写为 "点"+数字，
+        再按 dec_data[1] 取角、dec_data[2] 取分：
+
+            角 = 小数点后第 1 位（原样）
+            分 = 小数点后第 2 位（原样）
+
+        自身不做任何舍入（5.559 -> 伍角伍分，5.999 -> 玖角玖分）。缺陷只在两步的
+        先后：小数先被截到 16 位，而那是一次纯截断，被截掉的部分直接消失——当
+        玖角玖分之后全是 9 时，本该进到“元”的进位就丢了：
+
+            10.999999999999999999 -> 壹拾元玖角玖分（应为 壹拾壹元整）
+            0.999999999999999999  -> 玖角玖分      （应为 壹元整）
+
+        修复不改角分映射，也不对 16 位以内的小数做任何舍入，只让原本被截掉的
+        数字完成它们一直隐含的进位。
+        """
+        jiao = int(decimal_data[0])
+        fen = int(decimal_data[1]) if len(decimal_data) > 1 else 0
+
+        if len(decimal_data) > 16 and decimal_data[:2] == "99":
+            # 只有玖角玖分能吸收进位；其它角分保持原样，结果不可能改变
+            if decimal_data[2:16].strip("9") == "" and decimal_data[16:].strip("9") == "":
+                return str(int(integer_data) + 1), "点零零分"
+
+        return integer_data, "点" + NUMBER_UP_AN2CN[jiao] + NUMBER_UP_AN2CN[fen]
+
+    def __decimal_to_chinese(self, decimal_data: str, o_mode: str, max_len: int) -> str:
+        len_decimal_data = len(decimal_data)
+
+        if len_decimal_data > max_len:
+            warn(f"注意：小数部分长度为 {len_decimal_data} ，将自动截取前 {max_len} 位有效精度！")
+            decimal_data = decimal_data[:max_len]
+
+        if len_decimal_data:
+            output_an = "点"
+        else:
+            output_an = ""
+
+        if o_mode == "low":
+            numeral_list = NUMBER_LOW_AN2CN
+        elif o_mode == "up":
+            numeral_list = NUMBER_UP_AN2CN
+        else:
+            raise ValueError(f"error mode: {o_mode}")
+
+        for data in decimal_data:
+            output_an += numeral_list[int(data)]
+        return output_an
